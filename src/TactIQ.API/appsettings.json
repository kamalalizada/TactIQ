{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "TactIQ",
    "Audience": "TactIQ",
    "Key": "",
    "ExpiryHours": 12
  },
  "Guests": {
    "MaxAccounts": 50,
    "RetentionDays": 7,
    "TokenDays": 90,
    "PerAddressPerHour": 5
  },
  "LiveMatches": {
    "MaxConcurrent": 3
  }
}
