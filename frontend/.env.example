# Backend API for the dev server's proxy. Use 127.0.0.1 rather than localhost:
# Node resolves localhost to ::1 first, and an API bound only to IPv4 would
# then refuse the proxied request.
#
# Copy this file to .env to change it. A production build needs nothing here:
# the API serves the built files itself, so both share one origin.
VITE_API_URL=http://127.0.0.1:5199
